                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "energy_j": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "pulse_ns": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "outcome": {
                    "type": "string",
                    "enum": ["nominal", "partial", "misfire", "aborted"]
