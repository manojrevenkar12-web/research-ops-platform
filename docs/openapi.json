{
  "openapi": "3.1.0",
  "info": {
    "title": "Research operations platform API",
    "version": "1.0.0",
    "description": "Internal apps on one platform: shot log and target inventory, grant time and cost reporting."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "entra": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Microsoft Entra ID access token"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status"],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "description": "the request id"
          }
        }
      }
    }
  },
  "paths": {
    "/api/access/model": {
      "get": {
        "summary": "The access model: roles, data classes and the rules of every table",
        "tags": ["platform"],
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "An RFC 9457 problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "entra": []
          }
        ]
      }
    },
    "/api/grants": {
      "get": {
        "summary": "Grants with their work packages and your role on each",
