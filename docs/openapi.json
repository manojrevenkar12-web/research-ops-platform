    "/api/shotlog/campaigns": {
      "get": {
        "summary": "Campaigns you can see, newest first, with shot counts",
        "tags": ["shotlog"],
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "An RFC 9457 problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "entra": []
          }
        ]
      },
      "post": {
        "summary": "Create a campaign you lead",
        "tags": ["shotlog"],
        "description": "Needs one of the roles: Scientist. Row-level security decides the rest.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^[A-Z0-9-]{3,20}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 200
                  },
                  "facility": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 200
                  },
                  "entity": {
                    "type": "string",
                    "enum": ["DE", "US"]
                  },
                  "classification": {
                    "type": "string",
                    "enum": ["internal", "restricted"]
                  },
                  "starts_on": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "ends_on": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["code", "title", "facility", "entity", "classification", "starts_on"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK"
          },
          "default": {
            "description": "An RFC 9457 problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "entra": []
          }
        ]
      }
    },
