    "/api/grants/time-entries": {
      "post": {
        "summary": "Record hours, optionally submitting them straight away",
        "tags": ["grants"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "work_date": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "work_package_id": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "activity": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "hours": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 24,
                    "multipleOf": 0.25
                  },
                  "note": {
                    "default": "",
                    "type": "string",
                    "maxLength": 1000
                  },
                  "submit": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": ["work_date", "activity", "hours"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK"
          },
          "default": {
            "description": "An RFC 9457 problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "entra": []
          }
        ]
      }
    },
    "/api/grants/time-entries/{id}": {
      "delete": {
        "summary": "Delete one of your draft entries",
